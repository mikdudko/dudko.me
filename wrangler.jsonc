{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dudko-me",
  "compatibility_date": "2026-10-01",
  // Static site: everything in public/ is served as is, no Worker code.
  "assets": {
    "directory": "./public"
  },
  "routes": [
    { "pattern": "dudko.me", "custom_domain": true },
    { "pattern": "www.dudko.me", "custom_domain": true }
  ]
}
